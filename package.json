{
  "name": "@bighatpoland/ui-angular",
  "version": "1.0.0",
  "description": "An Angular design system built from the Big Hat component contracts: Signal Forms controls, @angular/aria behaviour, DTCG tokens, and every component conforming to its WAI-ARIA APG pattern in CI.",
  "license": "MIT",
  "author": "Konstancja Tanjga-Nawrot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konstancja-tanjga/bighat-design-system-angular.git"
  },
  "homepage": "https://konstancja-tanjga.github.io/bighat-design-system-angular/",
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "angular",
    "signal-forms",
    "accessibility",
    "wcag",
    "aria",
    "storybook"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@angular/common": "^21.0.0 || ^22.0.0",
    "@angular/core": "^21.0.0 || ^22.0.0",
    "@angular/forms": "^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@angular/aria": "^21.0.0 || ^22.0.0",
    "@angular/cdk": "^21.0.0 || ^22.0.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "audit:drift": "node scripts/audit-drift.mjs src/styles > DRIFT-REPORT.md",
    "aria": "node scripts/audit-aria.mjs src > ARIA.md",
    "spec:validate": "node scripts/validate-spec.mjs",
    "docs:generate": "node scripts/generate-doc-pages.mjs",
    "docs:check": "node scripts/generate-doc-pages.mjs --check",
    "build": "npm run tokens && ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "storybook": "npm run docs:generate && ng run ui-angular:storybook",
    "build-storybook": "npm run tokens && npm run docs:generate && ng run ui-angular:build-storybook",
    "test": "vitest run",
    "verify": "npm run tokens:check && npm run spec:validate && npm run audit:drift && npm run aria && npm run docs:check && npm test"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@angular-devkit/architect": ">=0.2200.0 <0.2300.0",
    "@angular-devkit/core": "^22.2.0",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/angular-vite": "^10.6.0",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "ng-packagr": "^22.2.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.0",
    "storybook": "^10.6.0",
    "tslib": "^2.8.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "zone.js": "~0.16.0"
  }
}
