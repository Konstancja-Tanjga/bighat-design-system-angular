      "$type": "duration",
      "$value": {
        "value": 1400,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "linear": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        1,
        1
      ]
    },
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "Enters and leaves under one curve. The default."
    },
    "decelerate": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        0.2,
        1
      ],
      "$description": "Fast in, settles slowly. For things arriving."
    },
    "accelerate": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        1,
        1
      ],
      "$description": "For things leaving."
    }
  },
  "layerStep": {
    "$description": "Named stacking positions. Raw z-index above 4 fails the build; 0-4 stays legal for sibling ordering inside one component's own stacking context.",
    "base": {
      "$type": "number",
      "$value": 0
    },
    "raised": {
      "$type": "number",
      "$value": 10
    },
    "sticky": {
      "$type": "number",
      "$value": 30
    },
    "rail": {
      "$type": "number",
      "$value": 40
    },
    "overlay": {
      "$type": "number",
      "$value": 100
    },
    "toast": {
      "$type": "number",
      "$value": 1000
    }
  }
}
